    [ContextMenu("Gerar Frota Completa (Todos os 50 em Grade)")]
    public void GerarTodosEmGrade()
    {
        GameObject pai = new GameObject("Frota_50_Veiculos_Conceito");
        for (int i = 0; i < CATALOGO.Length; i++)
        {
            int col = i % 10;
            int lin = i / 10;
            Vector3 pos = transform.position + new Vector3(col * 6.5f, 0f, -lin * 13f);
            GameObject v = CriarVeiculo(i, pos, Quaternion.identity);
            v.transform.SetParent(pai.transform, true);
        }
    }

