    private void Start()
    {
        if (gerarAmostraAoIniciar)
        {
            Vector3 pos = pontoSpawnManual != null ? pontoSpawnManual.position : transform.position;
            CriarVeiculo(indiceSelecionado, pos, transform.rotation);
        }
    }

    private void Update()
    {
        if (!permitirTrocaComTeclaF2) return;
        bool apertouF2 = false;
#if ENABLE_INPUT_SYSTEM
        if (Keyboard.current != null && Keyboard.current.f2Key.wasPressedThisFrame) apertouF2 = true;
#endif
#if ENABLE_LEGACY_INPUT_MANAGER
        if (Input.GetKeyDown(KeyCode.F2)) apertouF2 = true;
#endif
        if (apertouF2)
        {
            indiceSelecionado = (indiceSelecionado + 1) % CATALOGO.Length;
            Transform alvo = Camera.main != null ? Camera.main.transform : transform;
            Vector3 pos = alvo.position + Vector3.ProjectOnPlane(alvo.forward, Vector3.up).normalized * 6f;
            pos.y = 1.2f;
            if (veiculoTestadoAtual != null) Destroy(veiculoTestadoAtual);
            veiculoTestadoAtual = CriarVeiculo(indiceSelecionado, pos, Quaternion.LookRotation(Vector3.ProjectOnPlane(alvo.right, Vector3.up)));
            CidadeHUD.Notificar("Spawn: " + CATALOGO[indiceSelecionado].codigo + " — " + CATALOGO[indiceSelecionado].nome);
        }
    }

