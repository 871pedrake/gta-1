    public static GameObject CriarVeiculo(int indice, Vector3 posicao, Quaternion rotacao)
    {
        DefVeiculo d = CATALOGO[Mathf.Clamp(indice, 0, CATALOGO.Length - 1)];
        GameObject raiz = new GameObject(d.codigo + "_" + d.nome.Replace(" ", "_"));
        raiz.transform.SetPositionAndRotation(posicao, rotacao);

        Rigidbody rb = raiz.AddComponent<Rigidbody>();
        rb.mass = d.massa;

        BoxCollider col = raiz.AddComponent<BoxCollider>();
        col.size = new Vector3(d.larg, d.alt, d.comp);
        col.center = new Vector3(0f, d.alt * 0.5f, 0f);

        ControleVeiculo50 ctrl = raiz.AddComponent<ControleVeiculo50>();
        ctrl.codigo = d.codigo;
        ctrl.nomeModelo = d.nome;
        ctrl.tipoFisica = d.tipo;
        ctrl.velocidadeMaxKmh = d.velMax;
        ctrl.aceleracao = d.acel;
        ctrl.inclinacaoCurva = d.tipo == TipoFisicaVeiculo50.Moto ? 24f : 0f;
        ctrl.meioComprimento = d.comp * 0.5f;
        ctrl.ehVeiculoLongo = d.comp >= 7.5f;

        InteragirVeiculo50 inter = raiz.AddComponent<InteragirVeiculo50>();
        inter.offsetSaida = new Vector3(-(d.larg * 0.5f + 1.15f), 0.6f, 0f);
        inter.veiculoAbertoSemTeto = (d.tipo == TipoFisicaVeiculo50.Moto || d.arquetipo == "roadster" || d.arquetipo == "buggy" || d.arquetipo == "jetski");

        Color cPrim = Hex(d.corPrim);
        Color cSec = Hex(d.corSec);
        Color cDest = Hex(d.corDest);
        Color cVidro = new Color(0.10f, 0.16f, 0.24f, 0.85f);
        Color cPneu = new Color(0.10f, 0.10f, 0.11f);
        Color cAro = new Color(0.78f, 0.80f, 0.84f);
        Color cCromo = new Color(0.92f, 0.92f, 0.94f);

        if (d.tipo == TipoFisicaVeiculo50.Helicoptero)
            MontarHelicoptero(raiz.transform, d, ctrl, cPrim, cSec, cDest, cVidro);
        else if (d.tipo == TipoFisicaVeiculo50.Hovercraft)
            MontarHovercraft(raiz.transform, d, ctrl, cPrim, cSec, cDest, cVidro, cPneu);
        else if (d.tipo == TipoFisicaVeiculo50.Barco)
            MontarBarco(raiz.transform, d, ctrl, cPrim, cSec, cDest, cVidro);
        else if (d.tipo == TipoFisicaVeiculo50.Moto)
            MontarMotoOuAtv(raiz.transform, d, ctrl, cPrim, cSec, cDest, cPneu, cAro, cCromo);
        else
            MontarVeiculoTerrestre(raiz.transform, d, ctrl, cPrim, cSec, cDest, cVidro, cPneu, cAro, cCromo);

        return raiz;
    }

    private static void MontarVeiculoTerrestre(
        Transform raiz, DefVeiculo d, ControleVeiculo50 ctrl,
        Color cPrim, Color cSec, Color cDest, Color cVidro, Color cPneu, Color cAro, Color cCromo)
    {
        float hl = d.comp * 0.5f;

        // Ônibus Articulado especial (2 módulos + sanfona + 3 eixos)
        if (d.arquetipo == "articulated_bus")
        {
            float fLen = d.comp * 0.55f, rLen = d.comp * 0.38f, gap = d.comp * 0.07f;
            float fZ = hl - fLen * 0.5f, rZ = -hl + rLen * 0.5f;
            float bodyH = d.alt - d.vao - 0.15f;

            Peca(PrimitiveType.Cube, "Modulo_Dianteiro", raiz, new Vector3(0f, d.vao + bodyH * 0.5f, fZ), new Vector3(d.larg, bodyH, fLen), cPrim, 0.7f);
            Peca(PrimitiveType.Cube, "Vidros_Dianteiro", raiz, new Vector3(0f, d.vao + bodyH * 0.6f, fZ), new Vector3(d.larg + 0.02f, bodyH * 0.42f, fLen * 0.88f), cVidro, 0.9f);
            Peca(PrimitiveType.Cube, "Modulo_Traseiro", raiz, new Vector3(0f, d.vao + bodyH * 0.5f, rZ), new Vector3(d.larg, bodyH, rLen), cPrim, 0.7f);
            Peca(PrimitiveType.Cube, "Vidros_Traseiro", raiz, new Vector3(0f, d.vao + bodyH * 0.6f, rZ), new Vector3(d.larg + 0.02f, bodyH * 0.42f, rLen * 0.84f), cVidro, 0.9f);
            Peca(PrimitiveType.Cube, "Sanfona_Central", raiz, new Vector3(0f, d.vao + bodyH * 0.5f, (fZ - fLen * 0.5f + rZ + rLen * 0.5f) * 0.5f), new Vector3(d.larg * 0.94f, bodyH * 0.92f, gap * 1.15f), cSec, 0.25f);

            float[] eixosZ = { fZ + fLen * 0.3f, fZ - fLen * 0.28f, rZ - rLen * 0.15f };
            for (int i = 0; i < eixosZ.Length; i++)
            {
                Transform re = CriarRoda(raiz, "Roda_E" + i, new Vector3(-d.larg * 0.46f, d.raioRoda, eixosZ[i]), d.raioRoda, d.largRoda, cPneu, cAro, cDest);
                Transform rd = CriarRoda(raiz, "Roda_D" + i, new Vector3(d.larg * 0.46f, d.raioRoda, eixosZ[i]), d.raioRoda, d.largRoda, cPneu, cAro, cDest);
                if (i == 0) { ctrl.rodasDianteiras.Add(re); ctrl.rodasDianteiras.Add(rd); }
                else { ctrl.rodasTraseiras.Add(re); ctrl.rodasTraseiras.Add(rd); }
            }
            return;
        }

        float corpoH = Mathf.Max(0.42f, (d.alt - d.vao) * (1f - d.altCabin));
        float beltY = d.vao + corpoH;

        Peca(PrimitiveType.Cube, "Carroceria_Base", raiz,
            new Vector3(0f, d.vao + corpoH * 0.5f, 0f),
            new Vector3(d.larg, corpoH, d.comp * 0.96f), cPrim, 0.72f);

        Peca(PrimitiveType.Cube, "Saias_Laterais", raiz,
            new Vector3(0f, d.vao + 0.06f, 0f),
            new Vector3(d.larg * 1.01f, 0.10f, Mathf.Max(0.8f, d.eixos - d.raioRoda * 1.9f)), cSec, 0.35f);

        float cabH = Mathf.Max(0.32f, d.alt - beltY);
        float cabL = d.comp * d.capCabin;
        float cabZ = (d.arquetipo == "pickup" || d.arquetipo == "semi_truck" || d.arquetipo == "dump_truck" || d.arquetipo == "mixer_truck" || d.arquetipo == "firetruck" || d.arquetipo == "tow_truck")
            ? hl - cabL * 0.5f - d.comp * 0.12f
            : 0f;

        if (d.arquetipo != "roadster")
        {
            Peca(PrimitiveType.Cube, "Cabine_Estrutura", raiz,
                new Vector3(0f, beltY + cabH * 0.45f, cabZ),
                new Vector3(d.larg * 0.86f, cabH * 0.9f, cabL), cPrim, 0.72f);
            Peca(PrimitiveType.Cube, "Vidros_Cabine", raiz,
                new Vector3(0f, beltY + cabH * 0.44f, cabZ),
                new Vector3(d.larg * 0.88f, cabH * 0.64f, cabL * 0.88f), cVidro, 0.92f);
            Peca(PrimitiveType.Cube, "Vidro_Parabrisa", raiz,
                new Vector3(0f, beltY + cabH * 0.44f, cabZ),
                new Vector3(d.larg * 0.76f, cabH * 0.62f, cabL * 1.02f), cVidro, 0.92f);
        }
        else
        {
            Transform pb = Peca(PrimitiveType.Cube, "Parabrisa_Roadster", raiz,
                new Vector3(0f, beltY + 0.18f, cabZ + cabL * 0.38f),
                new Vector3(d.larg * 0.84f, 0.36f, 0.05f), cVidro, 0.95f);
            pb.localRotation = Quaternion.Euler(-35f, 0f, 0f);
            Peca(PrimitiveType.Cube, "Banco_E", raiz, new Vector3(-d.larg * 0.22f, beltY + 0.16f, -0.15f), new Vector3(0.4f, 0.42f, 0.4f), cSec, 0.2f);
            Peca(PrimitiveType.Cube, "Banco_D", raiz, new Vector3(d.larg * 0.22f, beltY + 0.16f, -0.15f), new Vector3(0.4f, 0.42f, 0.4f), cSec, 0.2f);
        }

        Peca(PrimitiveType.Cube, "Grade_Frontal", raiz,
            new Vector3(0f, d.vao + corpoH * 0.52f, hl - 0.01f),
            new Vector3(d.larg * 0.48f, corpoH * 0.35f, 0.06f), new Color(0.08f, 0.08f, 0.1f), 0.4f);

        Color corPara = d.extras.Contains("chrome_bumpers") ? cCromo : cSec;
        Peca(PrimitiveType.Cube, "Parachoque_F", raiz, new Vector3(0f, d.vao + 0.10f, hl + 0.03f), new Vector3(d.larg * 0.98f, 0.14f, 0.12f), corPara, 0.5f);
        Peca(PrimitiveType.Cube, "Parachoque_T", raiz, new Vector3(0f, d.vao + 0.10f, -hl - 0.03f), new Vector3(d.larg * 0.98f, 0.14f, 0.12f), corPara, 0.5f);

        for (int s = -1; s <= 1; s += 2)
        {
            Transform f = Peca(PrimitiveType.Cube, s < 0 ? "Farol_E" : "Farol_D", raiz,
                new Vector3(s * d.larg * 0.35f, d.vao + corpoH * 0.62f, hl - 0.01f),
                new Vector3(d.larg * 0.18f, 0.10f, 0.07f), new Color(1f, 0.97f, 0.84f), 0.9f);
            ctrl.farois.Add(f.GetComponent<Renderer>());

            Transform l = Peca(PrimitiveType.Cube, s < 0 ? "Lanterna_E" : "Lanterna_D", raiz,
                new Vector3(s * d.larg * 0.35f, d.vao + corpoH * 0.64f, -hl + 0.01f),
                new Vector3(d.larg * 0.20f, 0.09f, 0.07f), Color.red, 0.8f);
            ctrl.lanternas.Add(l.GetComponent<Renderer>());

            Peca(PrimitiveType.Cube, "Retrovisor", raiz,
                new Vector3(s * d.larg * 0.54f, beltY + 0.08f, hl * 0.28f),
                new Vector3(0.14f, 0.08f, 0.10f), cPrim, 0.7f);
        }

        if (d.raioRoda > 0.05f && d.eixos > 0.1f)
        {
            float zF = d.eixos * 0.5f;
            float zT = -d.eixos * 0.5f;
            float xR = d.larg * 0.46f;
            ctrl.rodasDianteiras.Add(CriarRoda(raiz, "Roda_FE", new Vector3(-xR, d.raioRoda, zF), d.raioRoda, d.largRoda, cPneu, cAro, cDest));
            ctrl.rodasDianteiras.Add(CriarRoda(raiz, "Roda_FD", new Vector3(xR, d.raioRoda, zF), d.raioRoda, d.largRoda, cPneu, cAro, cDest));
            ctrl.rodasTraseiras.Add(CriarRoda(raiz, "Roda_TE", new Vector3(-xR, d.raioRoda, zT), d.raioRoda, d.largRoda, cPneu, cAro, cDest));
            ctrl.rodasTraseiras.Add(CriarRoda(raiz, "Roda_TD", new Vector3(xR, d.raioRoda, zT), d.raioRoda, d.largRoda, cPneu, cAro, cDest));
        }

        // Extras específicos por modelo
        if (d.extras.Contains("spoiler_gt") || d.extras.Contains("wing_swan"))
        {
            Peca(PrimitiveType.Cube, "Aerofolio_Asa", raiz, new Vector3(0f, beltY + 0.24f, -hl + 0.20f), new Vector3(d.larg * 0.94f, 0.04f, 0.28f), cSec, 0.5f);
            Peca(PrimitiveType.Cube, "Suporte_Asa_E", raiz, new Vector3(-d.larg * 0.25f, beltY + 0.12f, -hl + 0.20f), new Vector3(0.04f, 0.24f, 0.14f), cSec, 0.5f);
            Peca(PrimitiveType.Cube, "Suporte_Asa_D", raiz, new Vector3(d.larg * 0.25f, beltY + 0.12f, -hl + 0.20f), new Vector3(0.04f, 0.24f, 0.14f), cSec, 0.5f);
        }
        if (d.extras.Contains("blower_v8"))
            Peca(PrimitiveType.Cube, "Supercharger_V8", raiz, new Vector3(0f, beltY + 0.14f, hl * 0.52f), new Vector3(0.36f, 0.26f, 0.44f), cCromo, 0.92f);
        if (d.extras.Contains("lightbar_police"))
        {
            Transform gV = Peca(PrimitiveType.Cube, "Giroflex_Vermelho", raiz, new Vector3(-0.32f, d.alt + 0.06f, cabZ + 0.1f), new Vector3(0.55f, 0.10f, 0.22f), Color.red, 0.8f);
            Transform gA = Peca(PrimitiveType.Cube, "Giroflex_Azul", raiz, new Vector3(0.32f, d.alt + 0.06f, cabZ + 0.1f), new Vector3(0.55f, 0.10f, 0.22f), Color.blue, 0.8f);
            ctrl.giroflexVermelho.Add(gV.GetComponent<Renderer>());
            ctrl.giroflexAzul.Add(gA.GetComponent<Renderer>());
        }
        if (d.extras.Contains("lightbar_amber") || d.extras.Contains("taxi_sign"))
        {
            Transform gAm = Peca(PrimitiveType.Cube, "Luminoso_Ambar", raiz, new Vector3(0f, d.alt + 0.06f, cabZ + 0.1f), new Vector3(0.65f, 0.12f, 0.22f), new Color(1f, 0.72f, 0.05f), 0.8f);
            ctrl.giroflexAmbar.Add(gAm.GetComponent<Renderer>());
        }
        if (d.extras.Contains("pushbar") || d.extras.Contains("bullbar"))
